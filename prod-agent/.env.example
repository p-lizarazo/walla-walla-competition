# The hosted runner injects the four API variables. For local practice, source
# the private repository-root .env instead of adding credentials here.
AGENT_MODE=auto
EXPERIMENT_ID=fast-path-v2
WORKERS=4
FALLBACK_WORKERS=1
VERIFIER_WORKERS=0
CPU_WORKERS=1
PYTHON_MEMORY_MB=1024
TEMPERATURES=0.0
MAX_TURNS=4
MAX_TOKENS=1024
MAX_TOOL_OUTPUT=4000
MODEL_TIMEOUT_SECONDS=10
FALLBACK_DEADLINE_SECONDS=22
PYTHON_TIMEOUT_SECONDS=12
THINKING_ENABLED=0
THINKING_MIN_POINTS=400
THINKING_BUDGET_400=1024
THINKING_BUDGET_500=1536
BOARD_POLL_SECONDS=1
SUBMISSION_INTERVAL_SECONDS=3.05
STRONG_CONFIDENCE_THRESHOLD=0.90
URGENT_CONFIDENCE_FLOOR=0.80
