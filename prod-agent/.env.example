# The hosted runner injects the four API variables. For local practice, source
# the private repository-root .env instead of adding credentials here.
AGENT_MODE=auto
EXPERIMENT_ID=fast-v1
WORKERS=6
VERIFIER_WORKERS=1
CPU_WORKERS=2
PYTHON_MEMORY_MB=1024
TEMPERATURES=0.0,0.15,0.3
MAX_TURNS=6
MAX_TURNS_400=10
MAX_TURNS_500=12
MAX_TOKENS=1536
MAX_TOKENS_400=3072
MAX_TOKENS_500=4096
MAX_TOOL_OUTPUT=6000
THINKING_ENABLED=0
THINKING_MIN_POINTS=400
THINKING_BUDGET_400=1024
THINKING_BUDGET_500=1536
BOARD_POLL_SECONDS=1.5
SUBMISSION_INTERVAL_SECONDS=3.1
STRONG_CONFIDENCE_THRESHOLD=0.90
URGENT_CONFIDENCE_FLOOR=0.80
